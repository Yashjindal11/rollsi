{
  "name": "rollsi",
  "version": "1.0.0",
  "description": "Moving averages, rolling statistics, growth, anomaly detection and forecasting as Excel custom functions (=ROLLSI.SMA, =ROLLSI.ROLLDAYS, ...) and as a TypeScript library.",
  "keywords": [
    "excel",
    "excel-addin",
    "office-addin",
    "custom-functions",
    "moving-average",
    "rolling-window",
    "time-series",
    "analytics",
    "forecasting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Yashjindal11/rollsi.git"
  },
  "homepage": "https://github.com/Yashjindal11/rollsi#readme",
  "license": "MIT",
  "author": "Yash Jindal",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=20 <25",
    "npm": ">=9 <12"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:lib": "tsc -p tsconfig.lib.json",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prepublishOnly": "npm run build:lib",
    "prestart": "npm run build:dev",
    "prettier": "office-addin-lint prettier",
    "start": "office-addin-debugging start manifest.xml",
    "start:web": "office-addin-debugging start manifest.xml web",
    "stop": "office-addin-debugging stop manifest.xml",
    "test": "mocha -r ts-node/register \"test/unit/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.xml",
    "validate:prod": "npm run build && office-addin-manifest validate dist/manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/custom-functions-runtime": "^1.6.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.25",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "custom-functions-metadata-plugin": "^2.1.3",
    "eslint-plugin-office-addins": "^4.0.10",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "mocha": "^11.7.4",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.1.6",
    "office-addin-prettier-config": "^2.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}
